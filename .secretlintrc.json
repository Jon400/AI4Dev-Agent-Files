{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Israeli mobile phone number (QA users' phones live in .env only)",
            "pattern": "/(?<![\\d-])05\\d-?\\d{7}(?![\\d-])/"
          },
          {
            "name": "Session cookie or WebAuthn private key value",
            "pattern": "/(?:Set-Cookie|Cookie|privateKey)[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9+/=_%.-]{16,}/i"
          }
        ]
      }
    }
  ]
}
