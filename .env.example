# Copy to .env (gitignored, and blocked from agents by a hook). Values here are examples.

# The TClock environment under test. Only https://dev.tclock.co.il is allowed;
# src/config/settings.ts rejects anything else before a browser opens.
BASE_URL=https://dev.tclock.co.il

# Browser options.
HEADLESS=true
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000

# Phone numbers of the two long-lived QA users the owner provisioned in the sandbox company.
# Use numbers you own. Needed by `npm run auth:enroll` and `npm run test:setup`; listing tests
# and unit tests work without them.
QA_OPERATOR_PHONE=
QA_EMPLOYEE_PHONE=

# Set by tools/dev-loop for each run. Generated when empty. Format: YYMMDD-HHMMSS-xxxx.
RUN_ID=
# Sub-folder of .orchestrate/runs/<run-id>/ for one Playwright invocation. Defaults to "run".
RUN_STEP=

# Only for `npm run auth:enroll`: which role to enroll (operator | employee).
ENROLL_ROLE=
